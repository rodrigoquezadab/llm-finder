{
  "name": "llm-atlas",
  "version": "2.0.0",
  "description": "Catálogo interactivo de modelos de lenguaje organizado por empresas, versiones y benchmarks",
  "main": "index.html",
  "scripts": {
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');const mime={'.html':'text/html','.css':'text/css','.js':'application/javascript','.json':'application/json'};http.createServer((req,res)=>{let p=path.join(__dirname,req.url==='/'?'index.html':req.url);if(fs.existsSync(p)&&fs.statSync(p).isFile()){res.writeHead(200,{'Content-Type':mime[path.extname(p)]||'text/plain'});fs.createReadStream(p).pipe(res);}else{res.writeHead(404);res.end('Not Found');}}).listen(8080,()=>console.log('LLM Atlas corriendo en http://localhost:8080'));\"",
    "sync": "node scripts/sync_leaderboards.js",
    "validate": "node -e \"const m=JSON.parse(require('fs').readFileSync('data/models.json')); console.log('✅ Catálogo válido con', m.length, 'modelos en', new Set(m.map(x=>x.provider)).size, 'empresas.');\""
  },
  "keywords": [
    "llm",
    "leaderboard",
    "benchmarks",
    "ai",
    "models",
    "artificial-intelligence"
  ],
  "author": "rodrigoquezadab",
  "license": "MIT"
}
